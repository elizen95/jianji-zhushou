{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Editorial historical map scene, version 1",
  "type":"object",
  "required":["schemaVersion","title","disclaimer","width","height","fps","durationInFrames","bounds","sources","routes"],
  "properties":{
    "schemaVersion":{"const":1},
    "title":{"type":"string","minLength":1},
    "subtitle":{"type":"string"},
    "period":{"type":"string"},
    "disclaimer":{"type":"string","minLength":1},
    "width":{"type":"integer","minimum":640},
    "height":{"type":"integer","minimum":360},
    "fps":{"type":"integer","minimum":1},
    "durationInFrames":{"type":"integer","minimum":1},
    "overlayFps":{"type":"number","minimum":1},
    "bounds":{"type":"array","items":{"type":"number"},"minItems":4,"maxItems":4,"description":"west, south, east, north. Runtime validates order and Mercator limits; no antimeridian crossing."},
    "mapRect":{"type":"array","items":{"type":"number"},"minItems":4,"maxItems":4,"description":"Optional map viewport [x,y,width,height] in canvas pixels, used to avoid presenter and subtitles."},
    "landFile":{"type":"string","description":"CLI-only relative path to local coastline GeoJSON. Omit for packaged 110m coastline."},
    "attribution":{"type":"string"},
    "showRouteGuide":{"type":"boolean"},
    "theme":{"$ref":"#/$defs/theme"},
    "sources":{"type":"array","items":{"type":"object","required":["id","title"],"properties":{"id":{"type":"string"},"title":{"type":"string"},"url":{"type":"string"},"type":{"type":"string"},"license":{"type":"string"},"note":{"type":"string"},"locator":{"type":"string"},"effectiveDate":{"type":"string"}}}},
    "routes":{"type":"array","items":{"$ref":"#/$defs/route"}},
    "camera":{"type":"array","items":{"type":"object","required":["at","center","zoom"],"properties":{"at":{"type":"number","minimum":0},"center":{"$ref":"#/$defs/point"},"zoom":{"type":"number","minimum":0.5,"maximum":6}}}},
    "places":{"type":"array","items":{"type":"object","required":["name","coordinates"],"properties":{"name":{"type":"string"},"coordinates":{"$ref":"#/$defs/point"},"dx":{"type":"number"},"dy":{"type":"number"},"fontSize":{"type":"number","exclusiveMinimum":0},"start":{"type":"number","minimum":0},"end":{"type":"number","minimum":0}}}},
    "cues":{"type":"array","items":{"type":"object","required":["at","date","text"],"properties":{"at":{"type":"number","minimum":0},"date":{"type":"string"},"text":{"type":"string"}}}},
    "layers":{"type":"array","items":{"type":"object","required":["id","kind","date","sourceId","start","end","geojson"],"properties":{"id":{"type":"string"},"kind":{"enum":["historical-border","military-control","claimed-area","schematic-area","modern-reference"]},"label":{"type":"string"},"date":{"type":"string"},"sourceId":{"type":"string"},"start":{"type":"number","minimum":0},"end":{"type":"number","minimum":0},"geojson":{"oneOf":[{"type":"object"},{"type":"string","description":"CLI-only relative file path"}]},"uncertain":{"type":"boolean"},"fill":{"type":"string"},"stroke":{"type":"string"},"opacity":{"type":"number","minimum":0,"maximum":1}}}}
  },
  "$defs":{
    "point":{"type":"array","prefixItems":[{"type":"number","minimum":-180,"maximum":180},{"type":"number","exclusiveMinimum":-85,"exclusiveMaximum":85}],"items":false,"minItems":2},
    "theme":{"type":"object","description":"Production values are mapped from the episode style.lock. Defaults are only an independent mechanics-demo skin.","properties":{"background":{"type":"string"},"land":{"type":"string"},"ocean":{"type":"string"},"coast":{"type":"string"},"ink":{"type":"string"},"muted":{"type":"string"},"accent":{"type":"string"},"secondary":{"type":"string"},"grid":{"type":"string"},"paper":{"type":"string"},"fontFamily":{"type":"string"}}},
    "route":{"type":"object","required":["id","label","date","sourceId","evidence","coordinates","start","end"],"properties":{"id":{"type":"string"},"label":{"type":"string"},"date":{"type":"string"},"sourceId":{"type":"string"},"evidence":{"enum":["documented","approximate","schematic"]},"coordinates":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/point"}},"start":{"type":"number","minimum":0},"end":{"type":"number","minimum":0},"color":{"type":"string"},"width":{"type":"number","minimum":1,"maximum":20},"strength":{"type":"number","minimum":0},"strengthSourceId":{"type":"string"}}}
  }
}
